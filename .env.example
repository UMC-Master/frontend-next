# Include /api/v1: endpoint functions append /login, /profile, etc.
NEXT_PUBLIC_API_BASE_URL=https://homemaster.cloud/api/v1
# Kakao REST API client ID (public identifier, not a client secret).
NEXT_PUBLIC_KAKAO_CLIENT_ID=
# Register this exact URL in Kakao and the backend KAKAO_REDIRECT_URI_DEV.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/sign-in
